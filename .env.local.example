# Docker Compose injects these local-only Vite overrides.
# Browser calls use /legacy and /api; Vite proxies them over the private Docker network.
VITE_LOCAL_DEVELOPMENT=true
VITE_API_BASE_URL=/api/
VITE_LEGACY_API_BASE_URL=/legacy
VITE_LEGACY_WS_BASE_URL=ws://localhost:5173/legacy
VITE_LEGACY_API_TARGET=http://127.0.0.1:8000
VITE_V2_API_TARGET=http://127.0.0.1:8001

# Optional, development-only synthetic catalog UI. Both default to disabled.
# VITE_ENABLE_CATALOG_UI_PREVIEW=true
# Local API access is a separate opt-in, only for an authorized disposable backend:
# VITE_ALLOW_CATALOG_LOCAL_API=true

# Additional opt-in for the local-only, synthetic enrollment request demo.
# Requires BOTH catalog UI and local API flags above; never enable in deployment.
# VITE_ENABLE_ENROLLMENT_UI_PREVIEW=true
